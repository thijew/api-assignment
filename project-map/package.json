{
  "name": "api-assignment",
  "version": "1.0.0",
  "description": "A school project where we learn to work with APIs",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist && mkdir dist",
    "start": "node server.js",
    "predev": "npm run clean && npm run build",
    "dev": "npm-run-all --parallel dev:*",
    "dev:client": "chokidar 'client/**/*' -c 'npm run build:client'",
    "dev:server": "nodemon server.js --ext js,liquid",
    "prebuild": "npm run clean",
    "build": "npm-run-all build:*",
    "build:client": "vite build"
  },
  "dependencies": {
    "@tinyhttp/app": "^2.5.2",
    "@tinyhttp/logger": "^2.1.0",
    "dotenv": "^16.4.7",
    "liquid-express-views": "^1.0.8",
    "liquidjs": "^10.7.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sirv": "^3.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "vite": "^6.2.5"
  }
}
